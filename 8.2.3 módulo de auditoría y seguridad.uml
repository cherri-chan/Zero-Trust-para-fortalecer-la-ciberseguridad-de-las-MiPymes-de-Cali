@startuml
left to right direction

skinparam shadowing false
skinparam actorStyle awesome
skinparam defaultFontName "Segoe UI"
skinparam roundcorner 15

skinparam rectangle {
    BackgroundColor #FAFAFA
    BorderColor #B0BEC5
    BorderThickness 2
}
skinparam usecase {
    BackgroundColor #E3F2FD
    BorderColor #1976D2
    FontColor #0D47A1
    ArrowColor #546E7A
}

actor "Resp. de seguridad" as Seguridad
actor "Administrador del sistema" as Admin

rectangle "Módulo: Auditoría y Seguridad" {
    usecase "Consultar eventos" as UC16
    usecase "Filtrar eventos" as UC17
    usecase "Generar reporte" as UC18
    usecase "Revocar sesión" as UC19
}

Admin --> UC16

Seguridad --> UC16
Seguridad --> UC17
Seguridad --> UC18
Seguridad --> UC19

UC16 .down.> UC17 : <<include>>
UC16 .down.> UC18 : <<extend>>
@enduml